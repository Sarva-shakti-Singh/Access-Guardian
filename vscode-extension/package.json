{
  "name": "access-guardian-fix-assistant",
  "displayName": "Access Guardian Fix Assistant",
  "description": "Prepare accessibility fixes for developer-selected HTML with an approval-gated diff.",
  "version": "0.3.0",
  "publisher": "access-guardian",
  "engines": { "vscode": "^1.85.0" },
  "categories": ["Other"],
  "main": "./src/extension.js",
  "activationEvents": [
    "onCommand:accessGuardian.prepareFix",
    "onCommand:accessGuardian.applyReviewedFix",
    "onCommand:accessGuardian.rejectReviewedFix"
  ],
  "contributes": {
    "commands": [
      { "command": "accessGuardian.prepareFix", "title": "Access Guardian: Prepare AI Fix for Selected HTML" },
      { "command": "accessGuardian.applyReviewedFix", "title": "Access Guardian: Apply Reviewed Fix" },
      { "command": "accessGuardian.rejectReviewedFix", "title": "Access Guardian: Reject Reviewed Fix" }
    ],
    "configuration": {
      "title": "Access Guardian",
      "properties": {
        "accessGuardian.backendUrl": {
          "type": "string",
          "default": "http://127.0.0.1:8000",
          "markdownDescription": "Access Guardian backend URL. HTTP is allowed only for localhost; remote endpoints must use HTTPS.",
          "scope": "window"
        },
        "accessGuardian.apiBaseUrl": {
          "type": "string",
          "default": "",
          "markdownDeprecationMessage": "Deprecated; use accessGuardian.backendUrl.",
          "description": "Deprecated compatibility setting.",
          "scope": "window"
        }
      }
    }
  },
  "scripts": { "test": "node --test test/*.test.js" },
  "devDependencies": {}
}
