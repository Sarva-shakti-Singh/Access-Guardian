# Local SQLite scan history (relative to the project root when started there)
ACCESS_GUARDIAN_DATABASE=backend/artifacts/access-guardian.sqlite3

# Comma-separated browser origins allowed to call the API.
ACCESS_GUARDIAN_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Only HTTP/S defaults are enabled unless explicitly configured.
ACCESS_GUARDIAN_ALLOWED_SCAN_PORTS=80,443

# Local pinned axe-core script installed with `npm ci` in frontend/
ACCESS_GUARDIAN_AXE_PATH=frontend/node_modules/axe-core/axe.min.js

ACCESS_GUARDIAN_LOG_LEVEL=INFO

# Optional OpenAI-compatible chat-completions provider for dashboard AI remediation.
ACCESS_GUARDIAN_AI_BASE_URL=http://127.0.0.1:11434/v1
ACCESS_GUARDIAN_AI_MODEL=qwen2.5-coder:7b
ACCESS_GUARDIAN_AI_API_KEY=

# Optional vision-capable model for opt-in screenshot and browser-evidence analysis.
# Set the exact model identifier supported by your provider; image input must be supported.
# The scanner never assumes that every configured text model accepts images.
ACCESS_GUARDIAN_VISION_BASE_URL=
ACCESS_GUARDIAN_VISION_MODEL=
ACCESS_GUARDIAN_VISION_API_KEY=
ACCESS_GUARDIAN_VISION_TIMEOUT_SECONDS=35
ACCESS_GUARDIAN_VISION_MAX_IMAGE_BYTES=3000000
